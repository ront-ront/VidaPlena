# Copie para .env e gere segredos próprios antes de iniciar.
APP_ENV=development
ENVIRONMENT_ID=development-local
HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://postgres:vp123@localhost:15435/vida-plena
REDIS_URL=redis://localhost:16379
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=
# Base64 canônico de 32 bytes aleatórios; não reutilizar entre ambientes.
FILE_ENCRYPTION_KEY=
SIGNATURE_PROVIDER=dev
MALWARE_SCANNER=dev
SHUTDOWN_TIMEOUT_MS=10000
# Homologação/produção exigem BR, origens HTTPS e providers sem dev.
DATA_REGION_COUNTRY=BR
AUDIT_RETENTION_YEARS=5

# Notifications: local mailbox only in development/test
EMAIL_SENDER=dev
EMAIL_MAILBOX_PATH=var/mailbox
# FRONTEND_ORIGIN must be one of CORS_ORIGINS
FRONTEND_ORIGIN=http://localhost:3000
NOTIFICATION_RETRY_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_POLL_SECONDS=5

FILE_STORAGE_PATH=var/files
FILE_ATTACHMENT_MAX_MB=10
FILE_RESULT_MAX_MB=20
FILE_RECORDING_MAX_MB=500
FILE_RECORDING_MAX_MINUTES=60
FILE_MAX_PER_RECORD=10
FILE_SIGNED_URL_TTL_SECONDS=120
FILE_ORPHAN_RECONCILE_MINUTES=60
PRIVACY_SUBJECT_REQUEST_DAYS=15
OPS_SLOW_REQUEST_MS=2000
OPS_READINESS_TIMEOUT_MS=2000
OPS_ALERTS_ENABLED=true
OPS_LOG_LEVEL=info
OPS_MAINTENANCE_MAX_HOURS_MONTH=2
OPS_MAINTENANCE_NOTICE_HOURS=48

AUTH_PASSWORD_MIN_LENGTH=10
AUTH_PASSWORD_COMMON_LIST_ENABLED=true
AUTH_BCRYPT_ROUNDS=12
AUTH_RESET_LINK_MINUTES=30
AUTH_EMAIL_VERIFY_LINK_HOURS=48
AUTH_RESET_REQUESTS_PER_HOUR=3
AUTH_PASSWORD_HISTORY_COUNT=5
PATIENT_LEGAL_ADULT_AGE_YEARS=18
AUTH_INVITE_LINK_HOURS=48
ACCOUNT_INACTIVITY_REVIEW_DAYS=90
# ADMIN_SEED_EMAIL / ADMIN_SEED_NAME / ADMIN_SEED_PASSWORD supplied by operator, never committed.
