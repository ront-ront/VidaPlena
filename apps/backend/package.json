{
  "name": "vida-plena-backend",
  "version": "1.0.0",
  "main": "server.ts",
  "repository": "https://github.com/ront-ront/VidaPlena",
  "author": "Yan-CarlosIF",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/shared/infra/http/server.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "start": "tsx src/shared/infra/http/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:seed": "tsx src/shared/infra/cli/accounts.ts seed",
    "accounts:review": "tsx src/shared/infra/cli/accounts.ts review",
    "test:vitest": "vitest run --config vitest.config.mts",
    "backup:cycle": "tsx ops/backup/backup-cycle.ts",
    "backup:files": "tsx ops/backup/file-snapshots.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prometheus-io/client": "^0.16.1",
    "@scalar/express-api-reference": "^0.10.33",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "jose": "^6.2.13",
    "otpauth": "^9.5.2",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vida-plena/biome-config": "1.0.0",
    "dotenv": "^18.0.4",
    "prisma": "^7.9.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@1.22.22"
}
