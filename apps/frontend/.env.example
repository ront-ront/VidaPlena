# Use o mesmo host do frontend (localhost ou 127.0.0.1) para o cookie SameSite=Lax.
# A origem exata do frontend deve estar em CORS_ORIGINS no backend.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3333
# Deve coincidir com AUTH_PASSWORD_MIN_LENGTH no backend.
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=10
# Deve coincidir com FILE_ATTACHMENT_MAX_MB no backend (file.attachment_max_mb).
NEXT_PUBLIC_ATTACHMENT_MAX_MB=10
# Deve coincidir com PATIENT_LEGAL_ADULT_AGE_YEARS no backend.
NEXT_PUBLIC_LEGAL_ADULT_AGE_YEARS=18
